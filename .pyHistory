import arcpy sr = arcpy.SpatialReference(4269)  # NAD83 lat/long xs, ys = [], [] with arcpy.da.SearchCursor("unique_acres_by_beetle", ["SHAPE@"], spatial_reference=sr) as cur:     for (g,) in cur:         e = g.extent         xs += [e.XMin, e.XMax]; ys += [e.YMin, e.YMax] print("West", round(min(xs), 4), "East", round(max(xs), 4)) print("North", round(max(ys), 4), "South", round(min(ys), 4))
from arcpy import metadata as md m = md.Metadata(r"C:\Users\Charlie Diraddo\Documents\GitHub\gunnison-beetle-kill\gunnison-beetle-kill.gdb") out = r"C:\Users\Charlie Diraddo\Documents\GitHub\gunnison-beetle-kill\data\metadata" m.exportMetadata(out + r"\gunnison_beetle_kill_fgdc.xml", "FGDC_CSDGM") m.exportMetadata(out + r"\gunnison_beetle_kill_iso19139.xml", "ISO19139")
